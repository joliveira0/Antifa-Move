# Copie este arquivo como .env e preencha os valores. Nunca envie o .env ao Git.

# URL de conexão PostgreSQL/Neon; mantenha sslmode=require em produção.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Porta HTTP usada pelo servidor local.
PORT=3000

# Chave longa e aleatória do link secreto de moderação.
# Gere com: openssl rand -hex 32
# Acesse o painel em /moderar/<valor-configurado-aqui>; compartilhe só com moderadores.
CHAVE_MODERACAO=cole-aqui-uma-chave-aleatoria-longa

# Segredo diferente da CHAVE_MODERACAO, usado para assinar o cookie de sessão.
# Gere separadamente com: openssl rand -hex 32
SESSION_SECRET=cole-aqui-outro-segredo-aleatorio

# Fora da Vercel, opcional para testar o Blob localmente.
# Na Vercel, conecte um Blob privado ao projeto para usar OIDC automaticamente.
# Se precisar, a Vercel também fornece BLOB_READ_WRITE_TOKEN nas variáveis do Blob.
